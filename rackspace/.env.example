HOME_IP=0.0.0.0
CLOUD_CLUSTER_IP=1.1.1.1
# LAN IP of the home cluster's Traefik ingress (LoadBalancer/node IP).
# Used for the *.local.tylermarques.com wildcard record; leave unset to skip it.
HOME_LAN_INGRESS_IP=192.168.0.x

# Garage S3 Storage (for Loki)
# These credentials are created after deploying Garage:
#   kubectl exec -n garage garage-0 -- garage key create loki-key
GARAGE_LOKI_ACCESS_KEY=
GARAGE_LOKI_SECRET_KEY=
